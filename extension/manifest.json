{
  "manifest_version": 3,
  "name": "Trak",
  "version": "0.1.0",
  "description": "Capture and visualize your research journey",
  "permissions": ["tabs", "webNavigation", "storage", "alarms"],
  "host_permissions": ["http://localhost:8080/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trak"
  }
}
